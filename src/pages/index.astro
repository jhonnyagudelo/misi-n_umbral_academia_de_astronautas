---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Misión Umbral · Academia de Astronautas</title>
    <meta name="theme-color" content="#101f33" />
    <meta name="description" content="Tu aventura espacial empieza aquí. Explora, cuida tu base lunar y aprende a tomar decisiones como un astronauta." />
  </head>
  <body>
    <div class="mission-scene" aria-hidden="true">
      <img src="/images/home-scene.svg" width="1000" height="400" alt="" fetchpriority="high" />
    </div>
    <main class="academy">
      <header class="masthead" aria-label="Misión Umbral">
        <span class="mission-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none"><path d="m16 4 9 23-9-5-9 5L16 4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M5 16h22M16 22v6" stroke="currentColor" stroke-width="1.4"/></svg>
        </span>
        <span>EXPLORAR. APRENDER. DESPEGAR.</span>
        <span class="edition">MISIÓN 01 <span aria-hidden="true">✦</span></span>
      </header>
      <section class="welcome" aria-labelledby="welcome-title">
        <p class="eyebrow"><span aria-hidden="true">✦</span> EL ESPACIO TE ESTÁ ESPERANDO</p>
        <h1 id="welcome-title">Misión <span>Umbral</span></h1>
        <p class="subtitle">Academia de Astronautas</p>
        <div class="scene-space" aria-hidden="true"></div>
        <div class="invitation">
          <section class="astronaut-dialogue" aria-label="Bienvenida del astronauta">
            <img class="astronaut-guide" src="/images/astronauta-guia.svg" width="86" height="109" alt="El astronauta guía te saluda." />
            <div class="speech-bubble">
              <p class="speaker">TU GUÍA ASTRONAUTA</p>
              <h2>Pequeñas decisiones. <span>Grandes misiones.</span></h2>
              <p class="mission-description">Prepara tu misión, explora el espacio y cuida tu base lunar.<br class="desktop-break" /> Cada decisión cuenta. ¿Te animas a ser astronauta?</p>
            </div>
          </section>
          <a class="play-button" href="/juego">Juega ya <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
          <p class="play-note">Una aventura para mentes curiosas de 7 a 12 años</p>
        </div>
      </section>
      <footer><span>MISIÓN UMBRAL <span aria-hidden="true">/</span> ACADEMIA DE ASTRONAUTAS</span><span>Hecho para aprender explorando <span aria-hidden="true">✦</span></span></footer>
    </main>
  </body>
</html>

<style>
  :global(html) { background: #101f33; }
  :global(body) {
    --page-gap: clamp(8px, 2dvh, 20px);
    margin: 0;
    min-height: 100dvh;
    padding: var(--page-gap);
    display: grid;
    place-items: center;
    color: #fff5e5;
    font-family: 'Segoe UI', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  /* Reserve room for the text and button; the illustration takes the remaining height. */
  .academy {
    width: min(1040px, 100%);
    height: calc(100dvh - 2 * var(--page-gap));
    position: relative;
    padding: 0 clamp(16px, 4vw, 48px);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    background: transparent;
    border: 0;
    border-radius: 0;
    isolation: isolate;
  }
  .masthead { min-height: clamp(36px, 7dvh, 60px); display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #ffffff26; font-size: 9px; font-weight: 750; letter-spacing: .12em; }
  .mission-mark { width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid #ffffff40; border-radius: 50%; flex-shrink: 0; }
  .mission-mark svg { width: 23px; height: 23px; }
  .edition { margin-left: auto; color: #c7d7e3; white-space: nowrap; }
  .edition span { margin-left: 8px; color: #ffc38b; font-size: 16px; }
  .welcome {
    min-height: 0;
    display: grid;
    grid-template-rows: auto auto auto minmax(0, 1fr) auto;
    gap: clamp(4px, 1.2dvh, 12px);
    padding: clamp(8px, 2dvh, 20px) 0;
    text-align: center;
  }
  .eyebrow { margin: 0; color: #d3dfeb; font-size: 9px; font-weight: 700; letter-spacing: .18em; }
  .eyebrow span { color: #ffc38b; margin-right: 7px; font-size: 13px; }
  h1 { margin: 0; font-size: clamp(30px, min(8.5vw, 8dvh), 64px); font-weight: 850; line-height: 1.05; letter-spacing: -.065em; }
  h1 span { color: #ffc38b; }
  .subtitle { margin: 0; font-size: clamp(15px, 2.8dvh, 21px); font-weight: 450; letter-spacing: .015em; }
  .scene-space { min-height: 0; }
  .mission-scene { position: fixed; inset: 0; margin: 0; pointer-events: none; background: #142438; }
  .mission-scene img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 57% center; }
  .mission-scene::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 25px 37px, #ffffffd9 1px, transparent 1.5px), radial-gradient(circle at 91px 113px, #dcecffb3 .7px, transparent 1.3px), radial-gradient(circle at 143px 61px, #ffdfb8cc 1.2px, transparent 1.8px);
    background-size: 183px 173px, 271px 229px, 347px 307px;
  }
  .mission-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #081426d9 0%, #08142699 20%, #0814260a 45%, #08142626 58%, #081426e6 79%, #081426f5 100%);
  }
  .invitation { display: grid; justify-items: center; gap: clamp(4px, .8dvh, 7px); }
  .astronaut-dialogue { position: relative; display: grid; grid-template-columns: 96px minmax(0, 1fr); align-items: end; gap: 16px; width: min(100%, 740px); }
  .astronaut-guide { display: block; width: 96px; height: auto; filter: drop-shadow(0 6px 10px #06122480); }
  .speech-bubble { position: relative; min-width: 0; padding: 13px 18px; border: 2px solid #f4c995; border-radius: 18px 18px 18px 5px; background: #fff5e2; color: #202e42; text-align: left; box-shadow: 0 6px 24px #06122440; }
  .speech-bubble::before { content: ''; position: absolute; left: -10px; bottom: 27px; width: 16px; height: 16px; transform: rotate(45deg); border-left: 2px solid #f4c995; border-bottom: 2px solid #f4c995; background: #fff5e2; }
  .speaker { margin: 0 0 5px; color: #8e3c20; font-size: 9px; font-weight: 800; line-height: 1.4; letter-spacing: .12em; }
  h2 { font-size: clamp(18px, 2.6dvh, 21px); font-weight: 750; line-height: 1.3; letter-spacing: -.035em; margin: 0; }
  h2 span { white-space: nowrap; }
  .mission-description { margin: 6px 0 0; font-size: 14px; color: #3f4f60; line-height: 1.5; }
  .play-button { display: inline-flex; align-items: center; justify-content: center; gap: 32px; min-width: 208px; min-height: 44px; margin: clamp(4px, 1dvh, 10px) 0 4px; padding: 9px 22px; border: 1px solid #a84020; border-radius: 11px; background: #bd4b28; box-shadow: 0 4px 0 #91371c; color: #fffaf1; font-weight: 750; font-size: 17px; text-decoration: none; transition: background .16s, transform .16s, box-shadow .16s; }
  .play-button svg { width: 22px; height: 22px; }
  .play-button:hover { background: #a73e1e; transform: translateY(-2px); box-shadow: 0 6px 0 #91371c; }
  .play-button:active { transform: translateY(3px); box-shadow: 0 1px 0 #91371c; }
  .play-button:focus-visible { outline: 3px solid #ffe2ac; outline-offset: 5px; }
  .play-note { color: #d2deeb; font-size: 10px; line-height: 1.3; margin: 0; }
  footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: clamp(24px, 4.5dvh, 38px); border-top: 1px solid #ffffff26; color: #c7d7e3; font-size: 8px; letter-spacing: .06em; }
  footer > span:first-child { font-weight: 700; }
  footer > span:first-child span { margin: 0 6px; color: #bd4b28; }
  footer > span:last-child > span { color: #bd4b28; margin-left: 6px; }
  @media (max-width: 650px) {
    .academy { padding: 0 16px; border-radius: 18px; }
    .masthead { gap: 7px; font-size: 7px; letter-spacing: .05em; }
    .mission-mark { width: 25px; height: 25px; }
    .mission-mark svg { width: 20px; height: 20px; }
    .edition span { margin-left: 4px; font-size: 12px; }
    .eyebrow { font-size: 8px; letter-spacing: .1em; }


    .astronaut-dialogue { display: block; }
    .astronaut-guide { position: absolute; z-index: 1; top: -47px; left: 6px; width: 70px; }
    .speech-bubble { padding: 10px 13px; border-radius: 16px; }
    .speech-bubble::before { top: -9px; left: 61px; bottom: auto; border-left: 2px solid #f4c995; border-top: 2px solid #f4c995; border-bottom: 0; }
    .speaker { padding-left: 65px; min-height: 17px; font-size: 8px; letter-spacing: .06em; }
    .mission-description { font-size: 13px; }
    .desktop-break { display: none; }
    .play-button { width: min(100%, 260px); }
    .play-note { font-size: 9px; }
    footer { justify-content: center; text-align: center; font-size: 7px; }
    footer > span:last-child { display: none; }
  }
  @media (max-height: 550px) and (min-width: 560px) {
    .mission-scene::after { background: linear-gradient(90deg, #0814260a, #08142633 35%, #081426df 55%, #081426f0); }
    .masthead { min-height: 32px; }
    .mission-mark { width: 24px; height: 24px; }
    .welcome { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); grid-template-rows: auto minmax(0, 1fr); padding: 10px 0; gap: 6px 24px; }
    .scene-space { display: none; }
    .eyebrow { display: none; }
    h1 { grid-column: 1; grid-row: 1; font-size: clamp(28px, 5dvh, 38px); }
    .subtitle { grid-column: 1; grid-row: 2; align-self: start; font-size: 15px; }
    .invitation { grid-column: 2; grid-row: 1 / -1; align-content: center; gap: 5px; }
    .astronaut-dialogue { display: block; }
    .astronaut-guide { position: absolute; top: auto; left: -70px; bottom: 0; width: 62px; }
    .speech-bubble { padding: 9px 12px; }
    .speech-bubble::before { top: auto; left: -10px; bottom: 27px; border-left: 2px solid #f4c995; border-bottom: 2px solid #f4c995; border-top: 0; }
    .speaker { padding: 0; min-height: 0; font-size: 8px; }
    h2 { font-size: 16px; }
    .mission-description { font-size: 12px; line-height: 1.4; }
    .desktop-break { display: none; }
    .play-button { min-width: 0; width: min(100%, 224px); margin-top: 4px; font-size: 16px; }
    .play-note { display: none; }

    footer { min-height: 23px; }
  }
</style>
