---
import '../styles/global.css';
import '../styles/pixel-ui.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href="/fonts/pixelify-sans.ttf" as="font" type="font/ttf" crossorigin />
    <title>Misión Umbral · Academia de Astronautas</title>
    <meta name="theme-color" content="#1d3347" />
    <meta name="description" content="Tu aventura espacial empieza aquí. Explora, cuida tu base marciana y aprende a tomar decisiones como un astronauta." />
  </head>
  <body>
    <div class="mission-scene" aria-hidden="true">
      <img src="/images/home-scene.png" width="768" height="432" alt="" fetchpriority="high" />
      <img class="destination-planet" src="/images/planeta-destino.png" width="64" height="64" alt="" />
      <canvas class="flying-rocket" width="192" height="192"><img src="/images/cohete.png" alt="" /></canvas>
    </div>
    <main class="academy">
      <header class="masthead" aria-label="Misión Umbral">
        <span class="mission-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none"><path d="m16 4 9 23-9-5-9 5L16 4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M5 16h22M16 22v6" stroke="currentColor" stroke-width="1.4"/></svg>
        </span>
        <span>EXPLORAR. APRENDER. DESPEGAR.</span>
        <span class="edition">MISIÓN 01 <span aria-hidden="true">✦</span></span>
      </header>
      <section class="welcome game-ui" aria-labelledby="welcome-title">
        <p class="eyebrow"><span aria-hidden="true">✦</span> EL ESPACIO TE ESTÁ ESPERANDO</p>
        <h1 id="welcome-title">Misión <span>Umbral</span></h1>
        <p class="subtitle">Academia de Astronautas</p>
        <div class="scene-space" aria-hidden="true"></div>
        <div class="invitation">
          <section class="astronaut-dialogue" aria-label="Bienvenida del astronauta">
            <img class="astronaut-guide" src="/images/astronauta-guia.png" width="64" height="80" alt="El astronauta guía te saluda." />
            <div class="speech-bubble pixel-panel">
              <p class="speaker">TU GUÍA ASTRONAUTA</p>
              <h2>Pequeñas decisiones. <span>Grandes misiones.</span></h2>
              <p class="mission-description">Prepara tu misión, explora el espacio y cuida tu base marciana.<br class="desktop-break" /> Cada decisión cuenta. ¿Te animas a ser astronauta?</p>
            </div>
          </section>
          <a class="play-button pixel-button" href="/juego">Juega ya <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor"><path d="M13 4h3v3h3v3h3v4h-3v3h-3v3h-3v-4h3v-2H2v-4h14V8h-3Z"/></svg></a>
          <p class="play-note">Una aventura para mentes curiosas de 7 a 12 años</p>
        </div>
      </section>
      <footer><span>MISIÓN UMBRAL <span aria-hidden="true">/</span> ACADEMIA DE ASTRONAUTAS</span><span>Hecho para aprender explorando <span aria-hidden="true">✦</span></span></footer>
    </main>
  </body>
</html>

<script>
  const scene = document.querySelector<HTMLElement>('.mission-scene');
  const rocket = document.querySelector<HTMLCanvasElement>('.flying-rocket');
  const planet = document.querySelector<HTMLElement>('.destination-planet');

  if (scene && rocket && planet) {
    const sprite = new Image();
    const context = rocket.getContext('2d');
    // Keep the nose aimed at the planet when the viewport changes shape.
    const alignRocket = () => {
      const ship = rocket.getBoundingClientRect();
      const destination = planet.getBoundingClientRect();
      const dx = destination.x + destination.width / 2 - ship.x - ship.width / 2;
      const dy = destination.y + destination.height / 2 - ship.y - ship.height / 2;
      const heading = Math.atan2(dy, dx);
      rocket.style.setProperty('--flight-heading', `${heading * 180 / Math.PI}deg`);
      if (context && sprite.complete && sprite.naturalWidth > 0) {
        // Rotate on the source pixel grid, then enlarge the canvas without smoothing.
        context.clearRect(0, 0, rocket.width, rocket.height);
        context.imageSmoothingEnabled = false;
        context.save();
        context.translate(rocket.width / 2, rocket.height / 2);
        context.rotate(heading);
        context.drawImage(sprite, -sprite.naturalWidth / 2, -sprite.naturalHeight / 2);
        context.restore();
        rocket.dataset.ready = 'true';
      }
    };

    let alignmentFrame = 0;
    const scheduleAlignment = () => {
      cancelAnimationFrame(alignmentFrame);
      alignmentFrame = requestAnimationFrame(alignRocket);
    };
    sprite.onload = scheduleAlignment;
    sprite.src = '/images/cohete.png';
    const layoutObserver = new ResizeObserver(scheduleAlignment);
    for (const element of [scene, rocket, planet]) layoutObserver.observe(element);
    window.addEventListener('resize', scheduleAlignment, { passive: true });
    alignRocket();
  }
</script>

<style>
  :global(html) { background: #1d3347; }
  :global(body) {
    --page-gap: clamp(8px, 2dvh, 20px);
    margin: 0;
    min-height: 100dvh;
    padding: var(--page-gap);
    display: grid;
    place-items: center;
    color: #fff5e5;
    font-family: 'Segoe UI', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  /* Reserve room for the text and button; the illustration takes the remaining height. */
  .academy {
    width: min(1040px, 100%);
    height: calc(100dvh - 2 * var(--page-gap));
    position: relative;
    padding: 0 clamp(16px, 4vw, 48px);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    background: transparent;
    border: 0;
    border-radius: 0;
    isolation: isolate;
  }
  .masthead { min-height: clamp(36px, 7dvh, 60px); display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #ffffff26; font-size: 9px; font-weight: 750; letter-spacing: .12em; }
  .mission-mark { width: 30px; height: 30px; display: grid; place-items: center; border: 1px solid #ffffff40; border-radius: 3px; flex-shrink: 0; }
  .mission-mark svg { width: 23px; height: 23px; }
  .edition { margin-left: auto; color: #c7d7e3; white-space: nowrap; }
  .edition span { margin-left: 8px; color: #f4cc75; font-size: 16px; }
  .welcome {
    min-height: 0;
    display: grid;
    grid-template-rows: auto auto auto minmax(0, 1fr) auto;
    gap: clamp(4px, 1.2dvh, 12px);
    padding: clamp(8px, 2dvh, 20px) 0;
    text-align: center;
  }
  .eyebrow { margin: 0; color: #d3dfeb; font-size: 9px; font-weight: 700; letter-spacing: .18em; }
  .eyebrow span { color: #f4cc75; margin-right: 7px; font-size: 13px; }
  h1 { margin: 0; font-size: clamp(30px, min(8.5vw, 8dvh), 64px); font-weight: 700; line-height: 1.05; letter-spacing: -.02em; }
  h1 span { color: #f4cc75; }
  .subtitle { margin: 0; font-size: clamp(15px, 2.8dvh, 21px); font-weight: 450; letter-spacing: .015em; }
  .scene-space { min-height: 0; }
  .mission-scene { position: fixed; inset: 0; margin: 0; pointer-events: none; background: #233b4e; }
  .mission-scene img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 57% center; image-rendering: pixelated; }
  .mission-scene .destination-planet { position: absolute; z-index: 1; left: 82%; top: 25%; width: 96px; height: auto; object-fit: contain; transform: translate(-50%, -50%); }
  .mission-scene .flying-rocket { position: absolute; left: 55%; top: 46%; width: 288px; height: auto; image-rendering: pixelated; transform: translate(-50%, -50%); }
  .mission-scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #081426d9 0%, #08142699 20%, #0814260a 45%, #08142626 58%, #081426e6 79%, #081426f5 100%);
  }
  .invitation { display: grid; justify-items: center; gap: clamp(4px, .8dvh, 7px); }
  .astronaut-dialogue { position: relative; display: grid; grid-template-columns: 96px minmax(0, 1fr); align-items: end; gap: 16px; width: min(100%, 740px); }
  .astronaut-guide { display: block; width: 96px; height: auto; image-rendering: pixelated; }
  .speech-bubble { position: relative; min-width: 0; padding: 13px 18px; border-radius: 0; color: #f1f7fa; text-align: left; box-shadow: 4px 4px 0 #122638; }
  .speech-bubble::before { content: ''; position: absolute; left: -10px; bottom: 27px; width: 16px; height: 16px; transform: rotate(45deg); border-left: 2px solid #69d4e2; border-bottom: 2px solid #69d4e2; background: #203d52; }
  .speaker { margin: 0 0 5px; color: #f4cc75; font-size: 11px; font-weight: 700; line-height: 1.4; letter-spacing: .12em; }
  h2 { font-size: clamp(18px, 2.6dvh, 21px); font-weight: 750; line-height: 1.3; letter-spacing: -.035em; margin: 0; }
  h2 span { white-space: nowrap; }
  .mission-description { margin: 6px 0 0; font-size: 16px; color: #dce9f0; line-height: 1.5; }
  .play-button { display: inline-flex; align-items: center; justify-content: center; gap: 32px; min-width: 208px; min-height: 44px; margin: clamp(4px, 1dvh, 10px) 0 4px; padding: 9px 22px; border-radius: 0; box-shadow: 0 4px 0 #2e6d7d; color: #102b3e; font-weight: 750; font-size: 17px; text-decoration: none; transition: background .16s, transform .16s, box-shadow .16s; }
  .play-button svg { width: 22px; height: 22px; }
  .play-button:hover { transform: translateY(-2px); box-shadow: 0 6px 0 #2e6d7d; }
  .play-button:active { transform: translateY(3px); box-shadow: 0 1px 0 #2e6d7d; }
  .play-button:focus-visible { outline: 3px dashed #ffe49a; outline-offset: 4px; }
  .play-note { color: #d2deeb; font-size: 10px; line-height: 1.3; margin: 0; }
  footer { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: clamp(24px, 4.5dvh, 38px); border-top: 1px solid #ffffff26; color: #c7d7e3; font-size: 10px; letter-spacing: .06em; }
  footer > span:first-child { font-weight: 700; }
  footer > span:first-child span { margin: 0 6px; color: #69d4e2; }
  footer > span:last-child > span { color: #69d4e2; margin-left: 6px; }
  @media (max-width: 650px) {
    .mission-scene .destination-planet { left: 82%; top: 29%; width: 64px; }
    .mission-scene .flying-rocket { left: 45%; top: 44%; width: 192px; }
    .academy { padding: 0 16px; border-radius: 18px; }
    .masthead { gap: 7px; font-size: 7px; letter-spacing: .05em; }
    .mission-mark { width: 25px; height: 25px; }
    .mission-mark svg { width: 20px; height: 20px; }
    .edition span { margin-left: 4px; font-size: 12px; }
    .eyebrow { font-size: 8px; letter-spacing: .1em; }


    .astronaut-dialogue { display: block; }
    .astronaut-guide { position: absolute; z-index: 1; top: -43px; left: 6px; width: 64px; }
    .speech-bubble { padding: 10px 13px; border-radius: 0; }
    .speech-bubble::before { top: -9px; left: 61px; bottom: auto; border-left: 2px solid #69d4e2; border-top: 2px solid #69d4e2; border-bottom: 0; }
    .speaker { padding-left: 65px; min-height: 17px; font-size: 10px; letter-spacing: .06em; }
    .mission-description { font-size: 15px; }
    .desktop-break { display: none; }
    .play-button { width: min(100%, 260px); }
    .play-note { font-size: 9px; }
    footer { justify-content: center; text-align: center; font-size: 7px; }
    footer > span:last-child { display: none; }
  }
  @media (max-height: 600px) and (max-width: 650px) {
    .mission-scene .destination-planet { left: 84%; top: 34%; width: 64px; }
    .mission-scene .flying-rocket { left: 49%; top: 32%; width: 144px; }
    .eyebrow { display: none; }
    .astronaut-guide { width: 48px; top: -27px; }
    .mission-description { line-height: 1.3; }
  }
  @media (max-height: 520px) and (max-width: 550px) {
    .mission-scene .destination-planet { left: 92%; top: 12%; width: 32px; }
    .mission-scene .flying-rocket { left: 91%; top: 23%; width: 96px; }
    .astronaut-guide { left: auto; right: 8px; top: 3px; width: 28px; }
    .speaker { padding-left: 0; padding-right: 32px; }
    .speech-bubble::before { display: none; }
  }
  @media (max-height: 550px) and (min-width: 560px) {
    .mission-scene .destination-planet { left: 90%; top: 20%; width: 32px; }
    .mission-scene .flying-rocket { left: 23%; top: 57%; width: 192px; }
    .mission-scene::after { background: linear-gradient(90deg, #0814260a, #08142633 35%, #081426df 55%, #081426f0); }
    .masthead { min-height: 32px; }
    .mission-mark { width: 24px; height: 24px; }
    .welcome { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); grid-template-rows: auto minmax(0, 1fr); padding: 10px 0; gap: 6px 24px; }
    .scene-space { display: none; }
    .eyebrow { display: none; }
    h1 { grid-column: 1; grid-row: 1; font-size: clamp(28px, 5dvh, 38px); }
    .subtitle { grid-column: 1; grid-row: 2; align-self: start; font-size: 15px; }
    .invitation { grid-column: 2; grid-row: 1 / -1; align-content: center; gap: 5px; }
    .astronaut-dialogue { display: block; }
    .astronaut-guide { position: absolute; top: auto; left: -70px; bottom: 0; width: 64px; }
    .speech-bubble { padding: 9px 12px; }
    .speech-bubble::before { top: auto; left: -10px; bottom: 27px; border-left: 2px solid #69d4e2; border-bottom: 2px solid #69d4e2; border-top: 0; }
    .speaker { padding: 0; min-height: 0; font-size: 10px; }
    h2 { font-size: 16px; }
    .mission-description { font-size: 14px; line-height: 1.4; }
    .desktop-break { display: none; }
    .play-button { min-width: 0; width: min(100%, 224px); margin-top: 4px; font-size: 16px; }
    .play-note { display: none; }

    footer { min-height: 23px; }
  }
</style>
