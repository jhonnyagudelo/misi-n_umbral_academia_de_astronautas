---
import "../styles/global.css";
import "../styles/pixel-ui.css";
import "../styles/mission.css";
import "../styles/playground.css";
import "../styles/space-scene.css";
import "../styles/habitat.css";
import "../styles/feedback.css";
import "../styles/clarity.css";
import "../styles/preparation.css";
import GameRoot from "../components/GameRoot";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Prepara tu traje, elige tu nave y rescata una base marciana en un entrenamiento educativo de decisiones y recursos." />
    <link rel="preload" href="/fonts/pixelify-sans.ttf" as="font" type="font/ttf" crossorigin />
    <title>Tu misión | Misión Umbral</title>
  </head>

  <body class="mission-body">
    <main><GameRoot client:load /></main>
    <noscript>Este entrenamiento necesita JavaScript para mover tarjetas y calcular recursos. Actívalo para jugar. <a href="/">Volver a la portada</a>.</noscript>
  </body>
</html>
